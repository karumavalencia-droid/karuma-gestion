# Supabase project settings (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reservation and review emails (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESERVAS_EMAIL_FROM="Karuma Sushi & Grill <reservas@your-domain.com>"
RESERVAS_EMAIL_REPLY_TO=reservas@your-domain.com

# Signs session cookies (admin + employee portal). Use at least 32 random
# characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Dedicated on purpose: if unset the code falls back to SUPABASE_SERVICE_ROLE_KEY
# for backward compatibility, but setting this decouples sessions from the
# Supabase key so rotating that key no longer logs everyone out.
KARUMA_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
# Optional overrides for the built-in administrator.
KARUMA_ADMIN_USERNAME=karuma
KARUMA_ADMIN_PASSWORD_HASH=your-bcrypt-password-hash

# Optional server-only JSON map. If omitted, the built-in 4-digit staff PINs are used.
KARUMA_ATTENDANCE_PINS={"employee-id":"0000"}

# Mobile attendance geofence. Copy the restaurant pin from Google Maps.
KARUMA_STORE_LATITUDE=39.4690812
KARUMA_STORE_LONGITUDE=-0.3751925
KARUMA_ATTENDANCE_RADIUS_METERS=150
KARUMA_ATTENDANCE_MAX_ACCURACY_METERS=100

# Karuma Coach (server-only; never use NEXT_PUBLIC_ variants)
OPENAI_API_KEY=sk-your-openai-api-key
# Optional model override; defaults to gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini

# Automatically generated when a Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-store-token

# Daily POS synchronization (RestoSuite -> sales_daily)
KARUMA_SYNC_SECRET=generate-a-random-secret-at-least-16-characters
CRON_SECRET=generate-a-different-random-secret-at-least-16-characters
#
# El cron /api/cron/restosuite lee el informe "Sales Summary Report" del
# backoffice de RestoSuite. Sin estas variables no hace ninguna petición
# externa y responde 503; la importación manual de CSV sigue funcionando.
#
# Cómo obtener los valores (una sola vez, desde el backoffice ya abierto en
# el navegador, en la consola del inspector):
#   - RESTOSUITE_TOKEN:          localStorage.getItem('vulcan-Token')
#   - el resto:                  JSON.parse(localStorage.getItem('userInfo'))
# El token caduca: cuando lo haga, el cron devuelve `authExpired: true` y
# hay que volver a copiarlo.
#
# Con estas variables en .env.local se puede hacer la carga inicial del
# histórico sin desplegar nada:  npm run sync:restosuite -- --days=92
# (admite --start=/--end= y --dry-run; es idempotente).
RESTOSUITE_TOKEN=paste-the-vulcan-token-here
RESTOSUITE_SHOP_ID=300401626
RESTOSUITE_CORPORATION_ID=210003986
RESTOSUITE_BRAND_ID=your-brand-id
RESTOSUITE_ORG_ID=your-org-id
RESTOSUITE_ORG_TYPE=7
# Optional (these are the defaults)
RESTOSUITE_BO_URL=https://bo.eu.restosuite.ai
RESTOSUITE_CURRENCY=EUR
RESTOSUITE_TIMEZONE=Europe/Madrid
RESTOSUITE_LANGUAGE_CODE=en_US
# location_id con el que se guardan las filas en sales_daily
SALES_DEFAULT_LOCATION_ID=karuma-valencia

# ─────────────────────────────────────────────────────────────
# SMS / OTP (Karuma Identity System)
# ─────────────────────────────────────────────────────────────
# Proveedor de SMS: "twilio" | "aliyun_intl" | "mock" (solo log)
SMS_PROVIDER=mock
# Twilio (para números +34, etc.) — usar From O Messaging Service SID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Aliyun International SMS (para números +34, etc.)
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_FROM=
ALIYUN_SMS_REGION=ap-southeast-1
# OTP
OTP_VALIDITY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ── Cuenta admin (owner) con 2FA por SMS ──────────────────────────────
# Login: usuario + contraseña + código SMS al teléfono del admin.
# Generar hash: node -e "console.log(require('bcryptjs').hashSync('TU_PASSWORD', 12))"
# ¡OJO! En .env los $ del hash bcrypt deben escaparse como \$
KARUMA_ADMIN_USERNAME=zhou
KARUMA_ADMIN_PASSWORD_HASH=\$2b\$12\$reemplaza_por_tu_hash
KARUMA_ADMIN_PHONE=+34600000000
