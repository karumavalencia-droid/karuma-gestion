# Supabase project settings (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reservation and review emails (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESERVAS_EMAIL_FROM="Karuma Sushi & Grill <reservas@your-domain.com>"
RESERVAS_EMAIL_REPLY_TO=reservas@your-domain.com

# Signs session cookies (admin + employee portal). Use at least 32 random
# characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
KARUMA_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
KARUMA_ADMIN_USERNAME=karuma
KARUMA_ADMIN_PASSWORD_HASH=your-bcrypt-password-hash

KARUMA_ATTENDANCE_PINS={"employee-id":"0000"}
KARUMA_STORE_LATITUDE=39.4690812
KARUMA_STORE_LONGITUDE=-0.3751925
KARUMA_ATTENDANCE_RADIUS_METERS=150
KARUMA_ATTENDANCE_MAX_ACCURACY_METERS=100

# Karuma Coach (server-only; never use NEXT_PUBLIC_ variants)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Google Business Profile reviews (server-only)
# OAuth scope required: https://www.googleapis.com/auth/business.manage
GOOGLE_BUSINESS_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_BUSINESS_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_BUSINESS_REFRESH_TOKEN=your-offline-refresh-token
GOOGLE_BUSINESS_ACCOUNT_ID=your-business-profile-account-id
GOOGLE_BUSINESS_LOCATION_ID=your-location-id
# Keep false until manual replies are verified in production. When true,
# /api/cron/google-reviews automatically replies only to unanswered 4–5 star reviews.
GOOGLE_REVIEWS_AUTO_REPLY=false

BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-store-token

# Daily POS synchronization and protected cron endpoints
KARUMA_SYNC_SECRET=generate-a-random-secret-at-least-16-characters
CRON_SECRET=generate-a-different-random-secret-at-least-16-characters
RESTOSUITE_API_URL=https://pos-provider.example/api/daily-sales
RESTOSUITE_API_TOKEN=your-pos-api-token
RESTOSUITE_LOCATION_ID=karuma-valencia
RESTOSUITE_API_KEY_HEADER=Authorization
RESTOSUITE_API_KEY_PREFIX="Bearer "
RESTOSUITE_DATE_PARAM=date
RESTOSUITE_LOCATION_PARAM=locationId

# SMS / OTP
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_FROM=
ALIYUN_SMS_REGION=ap-southeast-1
OTP_VALIDITY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Admin (owner) with SMS 2FA
KARUMA_ADMIN_USERNAME=zhou
KARUMA_ADMIN_PASSWORD_HASH=\$2b\$12\$reemplaza_por_tu_hash
KARUMA_ADMIN_PHONE=+34600000000
